name: Weekly backup

on:
  schedule:
    - cron: "0 9 * * 0"   # every Sunday, 09:00 UTC
  workflow_dispatch:      # also lets you run it by hand

jobs:
  backup:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Copy the database data
        env:
          DB_URL: ${{ secrets.SUPABASE_DB_URL }}
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq postgresql-client
          mkdir -p backups
          STAMP=$(date -u +%Y%m%d)
          pg_dump "$DB_URL" --schema=public --data-only --no-owner --no-privileges -f "backups/pcb-data-$STAMP.sql"

      - name: Save the copy in this private repository
        run: |
          git config user.name "backup-bot"
          git config user.email "backup-bot@users.noreply.github.com"
          git add backups
          git commit -m "Weekly backup $(date -u +%Y-%m-%d)" || echo "Nothing new to save"
          git push
